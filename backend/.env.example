# Copy to .env and fill in values
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
H2H_CACHE_TTL_SECONDS=21600
# First pre-race H2H forecasts are journaled locally (no personal data).
H2H_MONITOR_ENABLED=true
# Optional absolute path on durable local disk; default: backend/data/h2h-monitor.sqlite
# Avoid cloud-synced/network filesystems for the live SQLite database.
# H2H_MONITOR_DB_PATH=C:/chicane-data/h2h-monitor.sqlite

# Archive published forecasts and check for released results in the background.
PREDICTION_HISTORY_ENABLED=true
PREDICTION_HISTORY_REFRESH_SECONDS=60
# Recalculate from official completed GP qualifying; checks every 60 seconds.
# Requires prediction history to be enabled to preserve both forecast stages.
POST_QUALIFYING_ENABLED=true
# Persist this directory alongside the history database across deployments.
# PREDICTION_UPDATES_DIR=C:/chicane-data/prediction-updates
# Persistent local disk outside OneDrive, or a persistent deployment volume.
# PREDICTION_HISTORY_DB_PATH=C:/chicane-data/prediction-history.sqlite

# API key from resend.com - free tier works with onboarding@resend.dev as sender
RESEND_API_KEY=re_placeholder_replace_me
# Destination inbox for contact form submissions
CONTACT_EMAIL=you@example.com
